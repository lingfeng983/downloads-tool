<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.downloader.controller.MainController"
            prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@../css/style.css">

    <!-- 顶部工具栏 -->
    <top>
        <VBox spacing="10" styleClass="toolbar-box">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <!-- URL输入区 -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="下载链接:" styleClass="label-text"/>
                <TextField fx:id="urlField" HBox.hgrow="ALWAYS"
                           promptText="粘贴下载链接..." styleClass="url-field"/>
                <Button fx:id="startButton" text="开始下载"
                        onAction="#handleStartDownload" styleClass="start-button"/>
            </HBox>

            <!-- 设置区 -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="保存位置:" styleClass="label-text"/>
                <TextField fx:id="savePathField" prefWidth="400"
                           promptText="~/Downloads" styleClass="path-field"/>
                <Button text="浏览..." onAction="#handleBrowsePath" styleClass="browse-button"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="线程数:" styleClass="label-text"/>
                <ComboBox fx:id="threadComboBox" prefWidth="80" styleClass="thread-combo"/>
            </HBox>
        </VBox>
    </top>

    <!-- 中央下载列表 -->
    <center>
        <VBox>
            <padding>
                <Insets top="0" right="15" bottom="0" left="15"/>
            </padding>
            <TableView fx:id="downloadTable" VBox.vgrow="ALWAYS" styleClass="download-table">
                <columns>
                    <TableColumn fx:id="nameColumn" text="文件名" prefWidth="220"/>
                    <TableColumn fx:id="sizeColumn" text="大小" prefWidth="100"/>
                    <TableColumn fx:id="progressColumn" text="进度" prefWidth="200"/>
                    <TableColumn fx:id="speedColumn" text="速度详情" prefWidth="150"/>
                    <TableColumn fx:id="remainingColumn" text="剩余时间" prefWidth="100"/>
                    <TableColumn fx:id="statusColumn" text="状态" prefWidth="80"/>
                    <TableColumn fx:id="actionColumn" text="操作" prefWidth="140"/>
                </columns>
                <placeholder>
                    <Label text="暂无下载任务，请粘贴链接开始下载" styleClass="placeholder-text"/>
                </placeholder>
            </TableView>
        </VBox>
    </center>

    <!-- 底部状态栏 -->
    <bottom>
        <HBox spacing="20" styleClass="status-bar">
            <padding>
                <Insets top="10" right="15" bottom="10" left="15"/>
            </padding>
            <Label fx:id="statusLabel" text="就绪" styleClass="status-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="totalSpeedLabel" text="总速度: 0 B/s" styleClass="speed-text"/>
        </HBox>
    </bottom>
</BorderPane>
